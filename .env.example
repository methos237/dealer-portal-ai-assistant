# Azure. Copy to .env and fill from `az account show` and the deployment outputs.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=eastus2
AZURE_RESOURCE_GROUP=rg-dealer-portal
AZURE_STORAGE_ACCOUNT=stdpxxxxxxxxxxxxx
AZURE_DOCUMENTS_CONTAINER=documents

# Entra ID. Run scripts/entra-setup.sh and paste its output here.
AUTH_MICROSOFT_ENTRA_ID_ID=00000000-0000-0000-0000-000000000000
AUTH_MICROSOFT_ENTRA_ID_SECRET=web-app-client-secret
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
AzureAd__TenantId=00000000-0000-0000-0000-000000000000
AzureAd__ClientId=00000000-0000-0000-0000-000000000000
TEST_USER_PASSWORD=test-user-password
TEST_USER_DEALER_USER=dealer.user@yourtenant.onmicrosoft.com
TEST_USER_DEALER_ADMIN=dealer.admin@yourtenant.onmicrosoft.com
TEST_USER_THOR_ADMIN=thor.admin@yourtenant.onmicrosoft.com

# Microsoft 365 (scripts/entra-setup.sh prints these). M365_SITE: hostname:/sites/name or a Graph site id;
# M365_LIBRARY: document library the ingestion Function syncs; M365_MCP_URL: unset disables mcp-m365 in the assistant.
M365_TENANT_ID=00000000-0000-0000-0000-000000000000
M365_CLIENT_ID=00000000-0000-0000-0000-000000000000
M365_CLIENT_SECRET=m365-app-client-secret
M365_SITE=yourtenant.sharepoint.com:/sites/dealer-docs
M365_LIBRARY=Documents
M365_MCP_URL=http://localhost:8100/mcp

# Postgres (docker compose). assistant reads DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/dealer_portal

# web. AUTH_SECRET: openssl rand -base64 32. PORTAL_API_URL defaults to http://localhost:5080.
AUTH_SECRET=change-me
PORTAL_API_URL=http://localhost:5080

# assistant URL the web proxy forwards /api/assistant/* to
ASSISTANT_URL=http://localhost:8000

# Anthropic. Set a Console spend limit before use.
ANTHROPIC_API_KEY=sk-ant-...
