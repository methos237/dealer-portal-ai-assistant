# ---------------------------------------------------------------- Demo (docker compose --profile demo, scripts/demo.sh)
# The only value the demo needs. Set a Console spend limit before use; the five scripted conversations in
# scripts/demo.sh cost about 0.40 USD, a browser turn about 0.04 USD. Sign-in, reports and documents come from the
# compose stack itself (Keycloak realm in docker/keycloak, SQL reports, fixture documents); leave the Azure block
# empty and the containers use their own OIDC_* defaults from docker-compose.yml.
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------- Local development on the host (make dev)
# Postgres (docker compose). assistant reads DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/dealer_portal
# web. AUTH_SECRET: openssl rand -base64 32. PORTAL_API_URL defaults to http://localhost:5080.
AUTH_SECRET=change-me
PORTAL_API_URL=http://localhost:5080
# assistant URL the web proxy forwards /api/assistant/* to
ASSISTANT_URL=http://localhost:8000
# Traces (OTLP) to the compose Jaeger (make up). Unset = tracing off; on Azure Bicep points this at the collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Sign-in for the host processes: any OpenID Connect provider. OIDC_ISSUER serves /.well-known/openid-configuration
# and is the iss every token must carry; the api, assistant and mcp-m365 accept tokens whose aud is OIDC_AUDIENCE;
# web signs in as the AUTH_OIDC_* client and adds OIDC_API_SCOPE to the request so the access token is valid for the
# api (empty when the provider adds the audience itself). OIDC_ISSUER_INTERNAL: only when the issuer's public
# hostname is not reachable from the service (compose sets it to http://keycloak:8080/realms/dealer-portal).
# Against the demo Keycloak (docker compose --profile demo up -d keycloak), uncomment:
# OIDC_ISSUER=http://localhost:8080/realms/dealer-portal
# OIDC_AUDIENCE=dealer-portal-api
# OIDC_API_SCOPE=
# AUTH_OIDC_ID=dealer-portal-web
# AUTH_OIDC_SECRET=dealer-portal-web-secret
# Against Entra ID: scripts/entra-setup.sh prints the five values; paste them below.

# ---------------------------------------------------------------- Azure: Entra ID, Microsoft 365, Fabric, deployment
# Entra ID as the OIDC provider (scripts/entra-setup.sh prints these). Formats: OIDC_ISSUER
# https://login.microsoftonline.com/<tenant-id>/v2.0, OIDC_AUDIENCE <api client id>, OIDC_API_SCOPE
# api://<api client id>/access_as_user, AUTH_OIDC_ID <web client id>, AUTH_OIDC_SECRET <web client secret>.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_API_SCOPE=
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=
TEST_USER_PASSWORD=

# Azure (scripts/azure-up.sh, azure-down.sh).
AZURE_LOCATION=eastus2
AZURE_RESOURCE_GROUP=rg-dealer-portal
# Azure deployment (infra/, scripts/azure-up.sh). Secrets go to Key Vault; ids come from the sign-in block above.
AZURE_POSTGRES_PASSWORD=generate-with-openssl-rand
AZURE_BUDGET_EMAIL=you@example.com

# Microsoft 365 (scripts/entra-setup.sh prints these). M365_SITE: hostname:/sites/name or a Graph site id;
# M365_LIBRARY: document library the ingestion Function syncs; M365_MCP_URL: unset disables mcp-m365 in the assistant
# (compose attaches it whenever M365_SITE is set).
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SITE=
M365_LIBRARY=Documents
M365_MCP_URL=http://localhost:8100/mcp
# Fabric semantic model (scripts/fabric-up.sh prints both). Read by the api (/reports/summary) and mcp-m365
# (query_semantic_model) through the dealer-portal-m365 credentials above; unset = the api reports from SQL instead.
PowerBi__WorkspaceId=
PowerBi__SemanticModelId=
