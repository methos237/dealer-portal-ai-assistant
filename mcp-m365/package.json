{
  "name": "mcp-m365",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "MCP server exposing SharePoint document libraries through Microsoft Graph",
  "scripts": {
    "dev": "tsx watch src/http.ts",
    "stdio": "tsx src/stdio.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/http.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^5.2.1",
    "jose": "^6.1.3",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^26.6.3",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
