table claims
	lineageTag: 42785c09-5128-4b72-98e5-5429b988c95c
	sourceLineageTag: [dbo].[claims]

	measure 'Claim Count' = COUNTROWS(claims)
		formatString: #,##0
		lineageTag: 66604aab-93c1-47d3-85c6-30dc9c43fd75

	measure 'Claim Amount' = SUM(claims[amount])
		formatString: #,##0.00
		lineageTag: 95edac57-974b-4e94-b6f4-bd917277408c

	measure 'Avg Days To Close' = AVERAGEX(FILTER(claims, NOT ISBLANK(claims[approved_at])), DATEDIFF(claims[created_at], claims[approved_at], DAY))
		formatString: #,##0.0
		lineageTag: 3500d83e-7abc-4289-9310-4f80ebc17482

