{
  "realm": "dealer-portal",
  "enabled": true,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "Dealer.User", "description": "Dealer staff: read units, file claims and parts orders for own dealer." },
      { "name": "Dealer.Admin", "description": "Dealer management: everything Dealer.User plus dealer user administration." },
      { "name": "Thor.Admin", "description": "Manufacturer staff: all dealers, claim approval, reporting." }
    ]
  },
  "clients": [
    {
      "clientId": "dealer-portal-web",
      "name": "Dealer Portal (web)",
      "publicClient": false,
      "secret": "dealer-portal-web-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "defaultClientScopes": ["basic", "openid", "profile", "email", "roles"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "dealer-portal-api", "access.token.claim": "true" }
        },
        {
          "name": "roles claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    { "clientId": "dealer-portal-api", "name": "Dealer Portal (api)", "bearerOnly": true }
  ],
  "users": [
    {
      "id": "00000000-0000-4000-8000-000000000110",
      "username": "dealer.user",
      "email": "user@blueridge.example",
      "firstName": "Morgan",
      "lastName": "Ellis",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "portal" }],
      "realmRoles": ["Dealer.User", "offline_access"]
    },
    {
      "id": "00000000-0000-4000-8000-000000000111",
      "username": "dealer.admin",
      "email": "admin@blueridge.example",
      "firstName": "Riley",
      "lastName": "Chen",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "portal" }],
      "realmRoles": ["Dealer.Admin", "offline_access"]
    },
    {
      "id": "00000000-0000-4000-8000-000000000008",
      "username": "thor.admin",
      "email": "warranty@thor.example",
      "firstName": "Casey",
      "lastName": "Lindqvist",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "portal" }],
      "realmRoles": ["Thor.Admin", "offline_access"]
    }
  ]
}
